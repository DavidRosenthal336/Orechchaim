# Copy to .env and fill in. With RESEND_API_KEY blank, magic-link sign-in URLs
# are printed to the server console instead of emailed.

# Neon Postgres. DATABASE_URL is the pooled connection (used at runtime).
# DIRECT_URL is the direct connection — the same string with "-pooler" removed
# from the host — used for the schema push during build.
DATABASE_URL="postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# 32+ byte random secret used to sign session JWTs.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="change-me"

# Public base URL. Optional on Vercel (falls back to the deployment URL);
# set it to your production domain for stable magic-link URLs.
APP_URL=""

# Email. Sends magic links + weekly reports. Pick ONE backend:
#  (a) Gmail / SMTP — set SMTP_USER + SMTP_PASS (a Gmail "app password").
#  (b) Resend — set RESEND_API_KEY (needs a verified domain to email others).
# Leave all blank in dev to print emails to the console.
SMTP_USER=""
SMTP_PASS=""
# Optional SMTP overrides (defaults are Gmail):
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
RESEND_API_KEY=""
EMAIL_FROM="Orech Chaim <orechchaim@gmail.com>"

# Cron protection (optional). If set, cron endpoints require it via Bearer
# header or ?key=...; if unset, the (idempotent) cron is open.
CRON_SECRET=""
