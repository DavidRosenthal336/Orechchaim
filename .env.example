# Copy to .env and fill in. In local dev you only need the first three; with
# RESEND_API_KEY blank, magic-link sign-in URLs are printed to the server
# console instead of emailed.

# SQLite locally; at deploy, set to your Neon Postgres connection string and
# change `provider` to "postgresql" in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# 32+ byte random secret used to sign session JWTs.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="change-me"

# Public base URL of the app (used to build magic-link URLs).
APP_URL="http://localhost:3000"

# Resend (https://resend.com) — for magic links, reminders, and weekly reports.
# Leave blank in dev to print emails to the console.
RESEND_API_KEY=""
EMAIL_FROM="Orechchaim <onboarding@resend.dev>"
